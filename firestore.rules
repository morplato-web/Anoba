rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- YARDIMCI FONKSİYONLAR ---
    function isAuthenticated() { return request.auth != null; }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.email == 'morplato@gmail.com') ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roleString', '') == 'ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '') == 'anoba' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', '') == 'Anoba' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == 'morplato@gmail.com'
          )
        )
      );
    }

    function isOwner(data) {
      return isAuthenticated() && (
        request.auth.uid == data.get('ownerId', '') ||
        request.auth.uid == data.get('senderId', '') ||
        request.auth.uid == data.get('userId', '') ||
        request.auth.uid == data.get('uid', '')
      );
    }

    // --- KOLEKSİYONLAR ---

    // 1. KULLANICI ADI VE NUMARATÖR
    match /kullanici_adlari/{username} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    match /ad_numaralari/{numDoc} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() || isAdmin();
    }

    // 2. KULLANICI PROFİLLERİ
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['followerCount', 'fcmToken'])
      );

      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      match /notifications/{notifId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 3. TAKİP KAYITLARI
    match /follows/{followId} {
      allow read: if true;
      allow create, delete: if isAuthenticated() && (
        request.auth.uid == request.resource.data.followerId ||
        (resource != null && request.auth.uid == resource.data.followerId) ||
        isAdmin()
      );
    }

    // 4. HESAP SİLME / ÖZEL VERİLER
    match /privateUserData/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 5. GENEL İÇERİKLER (Photos, Videos, Ses vb.)
    match /{collectionId}/{docId} {
      allow read: if collectionId in [
            'photos', 'videos', 'ses', 'sesler', 'letters', 'animations', 'flowers',
            'police_assets', 'commando_assets', 'bekci_assets', 'mosaic_content',
            'anim_fall', 'anim_float', 'anim_fly', 'anim_pop',
            'general_chats', 'public_messages'
          ];
      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        isOwner(resource.data) ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'viewCount', 'clickCount', 'commentsCount', 'reactions', 'fcmToken',
          'badgeType', 'son_numara', 'reserved', 'isActive', 'shareCount',
          'is_published', 'is_popular', 'is_flagged', 'flag_reason', 'flagged_at'
        ])
      );

      allow delete: if isOwner(resource.data) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (isOwner(resource.data) || request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy']));
        allow delete: if isOwner(resource.data) || isAdmin();
      }
    }

    // 6. METE SİSTEMİ
    match /mete_content/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /{collectionId}/{docId} {
      allow read: if collectionId.matches('mete.*');
      allow write: if collectionId.matches('mete.*') && isAdmin();
    }

    // 7. SOHBETLER VE ARAMALAR
    match /private_chats/{chatId} {
      allow read, write: if isAuthenticated() && (
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*') ||
        isAdmin()
      );
      match /messages/{messageId} { allow read, write: if isAuthenticated(); }
    }

    match /groups/{groupId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} { allow read, write: if isAuthenticated(); }
    }

    match /chatRooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} { allow read, write: if isAuthenticated(); }
    }

    match /calls/{callId} { allow read, write: if isAuthenticated(); }

    // 8. REAKSİYONLAR VE ADMİN
    match /userReactions/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 🚀 KOLEKSİYON GRUBU (collectionGroup) SORGULARI İÇİN GÜVENLİK KURALLARI
    match /{path=**}/video_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /{path=**}/photo_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /{path=**}/ses_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /{path=**}/letter_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /admin_notifications/{docId} { allow read, write: if isAdmin(); }

    // 9. TOPLULUK SUNUCULARI & FREEHUB (community_servers)
    match /community_servers/{serverId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
