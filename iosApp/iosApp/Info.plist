<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Anoba</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- İzin Açıklamaları (App Store Onayı İçin Zorunlu) -->
    <key>NSCameraUsageDescription</key>
    <string>Anoba, fotoğraf ve video çekip paylaşabilmeniz için kameranıza erişim izni gerektirir.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Anoba, sesli mesaj, sesli mektup ve video kaydı alabilmeniz için mikrofonunuza erişim izni gerektirir.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Anoba, içerik paylaşabilmeniz ve profilinizi güncelleyebilmeniz için fotoğraf galerinize erişim izni gerektirir.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Anoba, kaydetmek istediğiniz görselleri fotoğraf arşivinize eklemek için izin gerektirir.</string>

    <!-- Özel URL Şeması (Android'deki anoba:// Deep Link'inin iOS Karşılığı) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.neval.anoba</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>anoba</string>
            </array>
        </dict>
    </array>

    <!-- Arka Planda Ses Oynatma Desteği (Ses Kayıtları ve Zil Sesi) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>remote-notification</string>
    </array>

    <!-- Ağ ve Medya Akış Güvenliği (ATS) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- Arayüz ve Ekran Yönelimleri -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
</dict>
</plist>
